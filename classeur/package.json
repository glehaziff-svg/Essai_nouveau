{
  "name": "mon-classeur",
  "productName": "Mon Classeur",
  "version": "1.0.0",
  "description": "Agenda et classement de papiers administratifs et médicaux, 100 % autonome.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "npm run vendor && electron .",
    "build:win": "npm run vendor && electron-packager . \"Mon Classeur\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/dist\" --ignore=\"\\.bat$\" --ignore=\"\\.sh$\" --ignore=\"\\.command$\" --ignore=\"^/README.md\" --ignore=\"^/fra.traineddata$\" --ignore=\"^/scripts\"",
    "vendor": "node scripts/prepare-vendor.js"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.4.11",
    "pdfjs-dist": "^3.11.174",
    "tesseract.js": "^6.0.1"
  }
}
