{
  "name": "mon-classeur",
  "productName": "Mon Classeur",
  "version": "1.0.0",
  "description": "Agenda et classement de papiers administratifs et médicaux, 100 % autonome.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . \"Mon Classeur\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"\\.bat$\" --ignore=\"\\.sh$\" --ignore=\"\\.command$\" --ignore=\"^/README.md\""
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "@electron/packager": "^18.3.6"
  }
}
